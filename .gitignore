# Anchored. An unanchored `bin/` matches at every depth, which silently
# swallowed plugin/bin/petctl — the shim the plugin's hooks invoke — and
# would have shipped a plugin pointing at a file that was never committed.
/bin/
/build/bin/
node_modules/

# Written by `petctl install claude`. It holds an absolute path to the petctl
# binary on this machine, which is meaningless in anyone else's clone — each
# developer runs the install themselves.
.claude/settings.json
.claude/settings.json.bak

# Wails writes generated JS bindings here.
ui/wailsjs/

# A local go.work would silently override the module requirements for anyone
# who clones this.
go.work
go.work.sum

.DS_Store
*.log
